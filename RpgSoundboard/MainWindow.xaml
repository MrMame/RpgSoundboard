<Window x:Class="HeroQuestSoundboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeroQuest Soundboard" Height="450" Width="800" Background="#2D2D2D">
    <Grid>
        <TabControl Background="#3D3D3D" Foreground="White">
            <TabItem Header="Dungeon">
                <ScrollViewer>
                    <WrapPanel Name="DungeonPanel" Margin="10">
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Wirtshaus">
                <WrapPanel Name="TavernPanel" Margin="10" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>