<Window x:Class="RpgSoundboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeroQuest Soundboard" Height="450" Width="800" Background="#2D2D2D">
    
    <Grid>
        <DockPanel>
            <Menu DockPanel.Dock="Top" Background="#3D3D3D" >
                <Menu.Resources>
                    <Style TargetType="MenuItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#3D3D3D"/>
                    </Style>
                    <Style TargetType="Separator">
                        <Setter Property="Background" Value="White"/>
                    </Style>
                </Menu.Resources>
                <MenuItem Header="_Collections" Foreground="White" BorderThickness="0,0,0,0">
                    <MenuItem Header="_Add New" Click="AddNewCollection_Click"/>
                    <Separator/>
                    <MenuItem Header="_Del Active" Click="DelActCollection_Click"/>
                </MenuItem>
            </Menu>
            <TabControl x:Name="SoundCollectionsTabControl" Background="#3D3D3D" Foreground="White">
                <TabItem Header="Dungeon">
                    <ScrollViewer>
                        <WrapPanel Name="DungeonPanel" Margin="10">
                        </WrapPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Wirtshaus">
                    <WrapPanel Name="TavernPanel" Margin="10" />
                </TabItem>
            </TabControl>


        </DockPanel>
    </Grid>
</Window>